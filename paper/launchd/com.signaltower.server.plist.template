<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.signaltower.server</string>
  <key>ProgramArguments</key>
  <array><string>__ROOT__/.venv/bin/python</string><string>__ROOT__/paper/server.py</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/paper/state/server.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/paper/state/server.log</string>
</dict>
</plist>
